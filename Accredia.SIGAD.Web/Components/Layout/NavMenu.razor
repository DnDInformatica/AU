@inject UserContext UserContext
@inject IDemoProfileContext DemoContext

<aside class="portal-sidebar sigad-sidebar @(IsCollapsed ? "sigad-sidebar--collapsed" : null)" aria-label="Navigazione SIGAD">

    <a class="portal-sidebar__back" href="/">
        <span aria-hidden="true">&larr;</span> SIGAD
    </a>

    <div class="portal-sidebar__user">
        <div class="portal-sidebar__user-avatar" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
        </div>
        <div class="portal-sidebar__user-info">
            <strong>@UserContext.Current?.Username</strong>
            <span>@DemoContext.GetCurrentProfile().Figure</span>
            @if (!string.IsNullOrWhiteSpace(DemoContext.GetCurrentProfile().OrganizationName))
            {
                <span>@DemoContext.GetCurrentProfile().OrganizationName</span>
            }
        </div>
    </div>

    <p class="portal-sidebar__area-label">GESTIONE ANAGRAFICHE</p>
    <hr class="portal-sidebar__divider" />

    <MudNavMenu Class="portal-sidebar__nav" Color="Color.Primary" Bordered="true">

        @NavLink("Dashboard", Icons.Material.Filled.Home, "/", NavLinkMatch.All)

        @if (_hasAnagraficheAccess)
        {
            @if (IsCollapsed)
            {
                @if (UserContext.HasPermission("SIDAC.MODULE.ORG.ACCESS"))
                {
                    @NavLink("Organizzazioni", Icons.Material.Filled.Business, "/organizzazioni")
                }
                @if (UserContext.HasPermission("SIDAC.MODULE.PERS.ACCESS"))
                {
                    @NavLink("Persone", Icons.Material.Filled.People, "/persone")
                    @NavLink("Documenti", Icons.Material.Filled.Folder, "/documenti")
                }
                @if (UserContext.HasPermission("SIDAC.MODULE.INC.ACCESS"))
                {
                    @NavLink("Incarichi", Icons.Material.Filled.Badge, "/incarichi")
                }
                @if (UserContext.HasPermission("SIDAC.MODULE.CERT.ACCESS"))
                {
                    @NavLink("Certificazioni", Icons.Material.Filled.Badge, "/certificazioni")
                }
                @if (_hasRuAccess)
                {
                    @NavLink("Dipendenti", Icons.Material.Filled.Groups, "/risorse-umane/dipendenti")
                }
            }
            else
            {
                <MudNavGroup Title="Anagrafiche"
                             Icon="@Icons.Material.Filled.FolderOpen"
                             @bind-Expanded="_anagraficheExpanded"
                             Class="sigad-nav-group">
                    <div class="sigad-nav-group-items">
                        @if (UserContext.HasPermission("SIDAC.MODULE.ORG.ACCESS"))
                        {
                            @NavLink("Organizzazioni", Icons.Material.Filled.Business, "/organizzazioni")
                        }
                        @if (UserContext.HasPermission("SIDAC.MODULE.PERS.ACCESS"))
                        {
                            @NavLink("Persone", Icons.Material.Filled.People, "/persone")
                            @NavLink("Documenti", Icons.Material.Filled.Folder, "/documenti")
                        }
                        @if (UserContext.HasPermission("SIDAC.MODULE.INC.ACCESS"))
                        {
                            @NavLink("Incarichi", Icons.Material.Filled.Badge, "/incarichi")
                        }
                        @if (UserContext.HasPermission("SIDAC.MODULE.CERT.ACCESS"))
                        {
                            @NavLink("Certificazioni", Icons.Material.Filled.Badge, "/certificazioni")
                        }
                        @if (_hasRuAccess)
                        {
                            @NavLink("Dipendenti", Icons.Material.Filled.Groups, "/risorse-umane/dipendenti")
                        }
                    </div>
                </MudNavGroup>
            }
        }

        @if (UserContext.HasPermission("SIDAC.MODULE.TIPO.ACCESS"))
        {
            @if (IsCollapsed)
            {
                @NavLink("Tipologiche", Icons.Material.Filled.List, "/tipologiche")
            }
            else
            {
                <p class="portal-sidebar__subgroup-label">CONFIGURAZIONE</p>
                @NavLink("Tipologiche", Icons.Material.Filled.List, "/tipologiche")
            }
        }

        @if (_hasAdminAccess)
        {
            @if (IsCollapsed)
            {
                @if (UserContext.HasPermission("IAM.USERS.MANAGE"))
                {
                    @NavLink("Gestione Utenti", Icons.Material.Filled.AccountCircle, "/admin/utenti")
                }
                @if (UserContext.HasPermission("IAM.ROLES.MANAGE"))
                {
                    @NavLink("Gestione Ruoli", Icons.Material.Filled.AdminPanelSettings, "/admin/roles")
                }
                @if (UserContext.HasPermission("IAM.PERMISSIONS.MANAGE"))
                {
                    @NavLink("Permessi", Icons.Material.Filled.VerifiedUser, "/admin/permissions")
                }
            }
            else
            {
                <p class="portal-sidebar__subgroup-label">AMMINISTRAZIONE</p>
                @if (UserContext.HasPermission("IAM.USERS.MANAGE"))
                {
                    @NavLink("Gestione Utenti", Icons.Material.Filled.AccountCircle, "/admin/utenti")
                }
                @if (UserContext.HasPermission("IAM.ROLES.MANAGE"))
                {
                    @NavLink("Gestione Ruoli", Icons.Material.Filled.AdminPanelSettings, "/admin/roles")
                }
                @if (UserContext.HasPermission("IAM.PERMISSIONS.MANAGE"))
                {
                    @NavLink("Permessi", Icons.Material.Filled.VerifiedUser, "/admin/permissions")
                }
            }
        }

    </MudNavMenu>

</aside>

@code {
    private SigadDemoProfile Profilo => DemoContext.GetCurrentProfile();
}
