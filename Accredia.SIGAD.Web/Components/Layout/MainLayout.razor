@inherits LayoutComponentBase
@implements IDisposable
@inject GatewayAuthenticationStateProvider AuthProvider
@inject IDemoProfileContext DemoContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserContext UserContext
@inject GatewayClient GatewayClient
@inject TokenService TokenService
@inject TokenRefreshService TokenRefreshService
@inject NavigationManager Navigation
@inject ILogger<MainLayout> Logger

<AppProviders />

@* Skip-to-content link for accessibility *@
<a href="#main-content" class="sigad-skip-link">
    Salta al contenuto principale
</a>

<MudLayout Class="sigad-shell">
    <MudAppBar Color="Color.Default" Elevation="0" Class="sigad-appbar">
        <div class="sigad-topbar-left">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                           aria-label="Apri o chiudi il menu laterale"
                           OnClick="@(() => ToggleDrawer())" Class="sigad-menu-button" />
            <a href="/" class="sigad-brand" aria-label="SIGAD - torna alla dashboard">
                <MudImage Src="/brand/logo-accredia.png" Alt="Accredia" Class="sigad-logo" />
                <span class="sigad-brand-copy">
                    <span class="sigad-brand-eyebrow">Ente Italiano di Accreditamento</span>
                    <span class="sigad-brand-name">SIGAD</span>
                </span>
            </a>
        </div>

        <div class="sigad-topbar-center">
            <AuthorizeView>
                <Authorized>
                    <GlobalSearch />
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="sigad-topbar-right">
            <AuthorizeView>
                <Authorized>
                    @if (demoEnabled)
                    {
                        <MudMenu Dense="true" Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Inherit"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="sigad-demo-switcher">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="sigad-demo-button">
                                    <span class="sigad-demo-badge">DEV</span>
                                    <span class="sigad-demo-role">@figuraCorrente</span>
                                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem Disabled="true"><MudText Typo="Typo.caption">Profilo di sviluppo</MudText></MudMenuItem>
                                <MudDivider />
                                @foreach (var profilo in profili)
                                {
                                    <MudMenuItem OnClick="@(() => CambiaProfilo(profilo.Role))">
                                        @profilo.Figure (@profilo.Role)
                                    </MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                    }
                    <MudMenu Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="sigad-user-button sigad-user-card">
                                @if (!string.IsNullOrEmpty(GetUserProfileImageUrl()))
                                {
                                    <MudAvatar Size="Size.Small" Image="@GetUserProfileImageUrl()" Class="sigad-avatar sigad-avatar-with-image" />
                                }
                                else
                                {
                                    <MudAvatar Size="Size.Small" Class="sigad-avatar sigad-avatar-initials">
                                        @GetUserInitials()
                                    </MudAvatar>
                                }
                                <span class="sigad-user-copy">
                                    <span class="sigad-user-name">@GetUsername()</span>
                                    <span class="sigad-user-role">@GetUserRoleSummary()</span>
                                </span>
                                <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="sigad-user-chevron" />
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Disabled="true">
                                <MudText Typo="Typo.caption">@GetUserRoleSummary()</MudText>
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem OnClick="Logout">Logout</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </Authorized>
                <NotAuthorized>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/login">Login</MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Mini"
               Width="280px"
               MiniWidth="72px"
               Elevation="0"
               ClipMode="DrawerClipMode.Always"
               Breakpoint="Breakpoint.Md"
               DisableOverlay="false"
               Class="@($"sigad-drawer {(_drawerOpen ? "sigad-drawer-expanded" : "sigad-drawer-collapsed")}")">
        <NavMenu IsCollapsed="!_drawerOpen" OnToggleDrawer="ToggleDrawer" />
    </MudDrawer>

    <MudMainContent Class="main-content" id="main-content">
        @* Le pagine controllano i permessi appena disegnate: senza questa attesa
           vedrebbero un utente ancora senza permessi e mostrerebbero "Accesso negato". *@
        @if (_contestoPronto)
        {
            @Body
        }
        else
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Caricamento dei permessi" />
        }
    </MudMainContent>

    <QuickDrawerHost />
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool demoEnabled => DemoContext.IsEnabled;
    private IReadOnlyList<SigadDemoProfile> profili => DemoContext.GetAvailableProfiles();
    private string figuraCorrente => DemoContext.GetCurrentProfile().Figure;

    private void CambiaProfilo(string role)
    {
        if (DemoContext.TrySetRole(role))
        {
            UserContext.OnDemoProfileChanged();
            InvokeAsync(StateHasChanged);
        }
    }
}
