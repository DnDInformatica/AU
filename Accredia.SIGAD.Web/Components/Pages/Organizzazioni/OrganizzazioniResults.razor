@namespace Accredia.SIGAD.Web.Components.Pages.AnagraficheIndex

@using Accredia.SIGAD.Web.Models.Anagrafiche
@using MudBlazor
@using Microsoft.AspNetCore.Components

<MudPaper Class="sigad-results-card" Elevation="0" Square="false">

    <!-- Header / Toolbar -->
    <div class="sigad-results-header">
        <div class="sigad-results-title">
            <MudAvatar Size="Size.Medium" Class="sigad-results-icon">
                <MudIcon Icon="@Icons.Material.Filled.Business" />
            </MudAvatar>

            <div class="sigad-results-title-text">
                <MudText Typo="Typo.subtitle1" Class="fw-bold">Risultati</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Organizzazioni censite</MudText>
            </div>

            @if (IsLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-2" />
            }
        </div>

        <div class="sigad-results-actions">
            @if (!string.IsNullOrWhiteSpace(ResultsHint))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Class="sigad-pill">
                    @ResultsHint
                </MudChip>
            }

            @if (SelectedCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="sigad-pill">
                    @SelectedCount selezionati
                </MudChip>
            }

            @if (BulkInProgress)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="sigad-pill">
                    @($"{BulkCurrent}/{BulkTotal}")
                </MudChip>
            }

            <MudTooltip Text="Aggiorna risultati">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="IsLoading || BulkInProgress"
                           StartIcon="@Icons.Material.Outlined.Refresh"
                           OnClick="RefreshAsync"
                           Class="sigad-btn-primary">
                    Aggiorna
                </MudButton>
            </MudTooltip>

            <MudDivider Vertical="true" Class="mx-2" />

            <MudTooltip Text="Esporta selezionati">
                <MudIconButton Icon="@Icons.Material.Outlined.Download"
                               Color="Color.Primary"
                               Disabled="@(SelectedCount == 0 || BulkInProgress)"
                               Size="Size.Small"
                               OnClick="OnExportSelected" />
            </MudTooltip>

            <MudTooltip Text="Elimina selezionati">
                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                               Color="Color.Error"
                               Disabled="@(SelectedCount == 0 || BulkInProgress)"
                               Size="Size.Small"
                               OnClick="OnDeleteSelected" />
            </MudTooltip>

            <MudMenu Dense="true"
                     Variant="Variant.Outlined"
                     Color="Color.Primary"
                     Disabled="@(SelectedCount == 0 || StatiAttivita.Count == 0 || BulkInProgress)"
                     StartIcon="@Icons.Material.Outlined.Edit"
                     Label="Stato"
                     Class="sigad-menu">
                @foreach (var stato in StatiAttivita)
                {
                    <MudMenuItem OnClick="@(() => OnChangeStatusSelected.InvokeAsync(stato))">
                        @stato.Label
                    </MudMenuItem>
                }
            </MudMenu>

            <MudMenu Dense="true"
                     Variant="Variant.Text"
                     Color="Color.Inherit"
                     Disabled="BulkInProgress"
                     EndIcon="@Icons.Material.Filled.MoreVert">
                @if (MoreActions is not null)
                {
                    @MoreActions
                }
                else
                {
                    <MudMenuItem Disabled="true">Nessuna azione</MudMenuItem>
                }
            </MudMenu>
        </div>
    </div>

    @if (BulkInProgress)
    {
        <div class="sigad-bulkbar">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Operazione in corso…
            </MudText>
            <div class="sigad-bulkbar-row">
                <MudProgressLinear Value="@BulkProgressPercent" Class="sigad-bulk-progress" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@($"{BulkProgressPercent}%")</MudText>
            </div>
        </div>
    }

    <!-- Table -->
    <MudTable Items="Items"
              ServerData="ServerData"
              Hover="true"
              Dense="false"
              Bordered="false"
              Striped="false"
              Elevation="0"
              Class="sigad-modern-table"
              @ref="_table">

        <HeaderContent>
            <MudTh Class="sigad-col-check">
                <span class="sigad-check" @onclick="ToggleSelectAllClick" @onclick:stopPropagation="true">
                    <MudIcon Icon="@(IsAllSelected? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                             Color="@(IsAllSelected ? Color.Primary : Color.Default)" />
                </span>
            </MudTh>
            <MudTh>Denominazione</MudTh>
            <MudTh Class="d-none d-md-table-cell">Ragione sociale</MudTh>
            <MudTh Class="d-none d-lg-table-cell">Partita IVA</MudTh>
            <MudTh Class="d-none d-lg-table-cell">Codice Fiscale</MudTh>
            <MudTh>Stato</MudTh>
            <MudTh Style="text-align:right; width:1%;">Azioni</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd Class="sigad-col-check">
                <span class="sigad-check" @onclick="@(() => ToggleRowSelectionClick(context))" @onclick:stopPropagation="true">
                    <MudIcon Icon="@(_selectedIds.Contains(context.OrganizzazioneId) ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                             Color="@(_selectedIds.Contains(context.OrganizzazioneId) ? Color.Primary : Color.Default)" />
                </span>
            </MudTd>

            <MudTd DataLabel="Denominazione">
                <div class="sigad-maincell">
                    <MudText Typo="Typo.body1" Class="sigad-linkwrap">
                        <a class="sigad-table-link"
                           href="@BuildDetailHref(context.OrganizzazioneId)"
                           @onclick:stopPropagation="true">
                            @context.Denominazione
                        </a>
                    </MudText>

                    @if (!string.IsNullOrWhiteSpace(context.RagioneSociale))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-md-none">
                            @context.RagioneSociale
                        </MudText>
                    }
                </div>
            </MudTd>

            <MudTd DataLabel="Ragione sociale" Class="d-none d-md-table-cell">
                @context.RagioneSociale
            </MudTd>

            <MudTd DataLabel="Partita IVA" Class="d-none d-lg-table-cell">
                <MudText Typo="Typo.body2" Class="sigad-mono">@context.PartitaIVA</MudText>
            </MudTd>

            <MudTd DataLabel="Codice Fiscale" Class="d-none d-lg-table-cell">
                <MudText Typo="Typo.body2" Class="sigad-mono">@context.CodiceFiscale</MudText>
            </MudTd>

            <MudTd DataLabel="Stato">
                <MudChip T="string"
                         Color="GetStatoColor.Invoke(context.StatoAttivitaId)"
                         Variant="Variant.Filled"
                         Size="Size.Small"
                         Class="sigad-state-chip">
                    @GetStatoLabel.Invoke(context.StatoAttivitaId)
                </MudChip>
            </MudTd>

            <MudTd DataLabel="Azioni" Style="text-align:right; white-space:nowrap;">
                <span @onclick:stopPropagation="true">
                    <MudTooltip Text="Anteprima">
                        <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => OnQuickPreview.InvokeAsync(context))"
                                       AriaLabel="Apri anteprima organizzazione" />
                    </MudTooltip>
                </span>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <div class="sigad-empty">
                @if (!HasActiveFilters && (string.IsNullOrWhiteSpace(Query) || Query.Trim().Length < 2))
                {
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="fw-bold mb-1">Inizia la ricerca</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Inserisci almeno 2 caratteri per cercare per denominazione,
                        oppure usa direttamente Codice Fiscale (16) o P.IVA (11).
                    </MudText>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6" Class="fw-bold mb-1">Nessun risultato</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Nessuna organizzazione trovata con i filtri correnti.
                    </MudText>
                }
            </div>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
        </PagerContent>

    </MudTable>

</MudPaper>
