@page "/Error"
@using System.Diagnostics

<PageTitle>Errore · SIGAD</PageTitle>

@* Pagina mostrata per gli errori non gestiti: nessun dettaglio tecnico per
   l'utente, solo il codice della richiesta che serve all'assistenza. *@
<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h5" HtmlTag="h1" tabindex="-1">Si è verificato un errore</MudText>
    <MudText Typo="Typo.body1" Class="mt-2">
        La richiesta non è stata completata. Riprova; se il problema persiste, segnalalo all'assistenza.
    </MudText>

    @if (ShowRequestId)
    {
        <MudText Typo="Typo.body2" Class="mt-4">
            Codice della richiesta da comunicare all'assistenza: <code>@RequestId</code>
        </MudText>
    }

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/" Class="mt-6">Torna alla Home</MudButton>
</MudContainer>
