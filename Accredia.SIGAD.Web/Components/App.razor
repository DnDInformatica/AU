@inject IWebHostEnvironment Ambiente
<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["accredia-tokens.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["accredia-custom.css"]" />
    <link rel="stylesheet" href="@Assets["Accredia.SIGAD.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* Dev Inspector (Ctrl+Alt+D): solo in Development; in Release i file non sono pubblicati. *@
    @if (Ambiente.IsDevelopment())
    {
        <link rel="stylesheet" href="css/dev-inspector.css" />
    }
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/sigad-download.js"></script>
    <script src="js/sigad-ui-enhancements.js"></script>
    <script src="_framework/blazor.web.js"></script>
    @if (Ambiente.IsDevelopment())
    {
        <script src="js/dev-inspector.js"></script>
    }
</body>

</html>
