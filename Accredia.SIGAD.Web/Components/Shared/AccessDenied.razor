@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="@($"mt-8 {Class}")">
    @* Contorno e non pieno: l'ocra non fa da fondo a grandi superfici (regole del Portale) e il testo secondario resta leggibile. *@
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            @Message
        </MudText>

        @if (ShowContactHint)
        {
            <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                Contatta un amministratore di sistema per richiedere l'accesso.
            </MudText>
        }

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   Href="@ReturnHref"
                   StartIcon="@Icons.Material.Filled.Home"
                   Class="mt-4">
            @ReturnLabel
        </MudButton>
    </MudAlert>
</MudContainer>
