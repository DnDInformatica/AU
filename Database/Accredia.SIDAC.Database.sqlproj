<Project Sdk="Microsoft.Build.Sql/1.0.0">
  <PropertyGroup>
    <Name>Accredia.SIDAC.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1040,CI</ModelCollation>
    <BlockOnPossibleDataLoss>True</BlockOnPossibleDataLoss>
    <TreatTSqlWarningsAsErrors>False</TreatTSqlWarningsAsErrors>
    <SuppressTSqlWarnings>71502;71558;71562</SuppressTSqlWarnings>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="bin\**\*.sql" />
    <Build Remove="obj\**\*.sql" />
    <Build Remove="_drift\**\*.sql" />
    <Build Remove="_baseline\**\*.sql" />
    <!-- Script di migrazione da eseguire in SSMS: non fanno parte del modello. -->
    <Build Remove="migrations\**\*.sql" />
    <None Include="migrations\**\*.sql" />
    <!-- Vista diagnostica su DMV Query Store: DacFx non modella
         sys.query_store_query / sys.query_store_query_text.
         Esclusa dal modello, resta presente nel database. -->
    <Build Remove="src\Reporting\Views\vw_GOV_ConsumerAdHocLegacy.sql" />
    <None Include="src\Reporting\Views\vw_GOV_ConsumerAdHocLegacy.sql" />
  </ItemGroup>
</Project>